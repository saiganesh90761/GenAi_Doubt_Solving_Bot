# OpenRouter (OpenAI-compatible). Server-only — never expose to the client.
OPENROUTER_API_KEY=

# Chat model id on OpenRouter
# NVIDIA Nemotron 3 Ultra (free): nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# Embedding model id on OpenRouter
# NVIDIA Nemotron 3 Embed 1B (free): nvidia/nemotron-3-embed-1b:free
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
